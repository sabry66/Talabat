rules_version = '2';

// قواعد الحماية: مين يقدر يقرا ويكتب إيه في قاعدة البيانات.
// - أي حد يشوف المطاعم والمنيو.
// - العميل يشوف طلباته بس، ويقدر يلغي الطلب قبل ما المطعم يقبله.
// - صاحب المطعم يشوف طلبات مطعمه بس، ويقبلها ويجهزها ويعدل المنيو.
// - المندوب يشوف الأوردرات اللي مستنية مندوب، وياخدها ويوصلها (لحد العدد اللي الأدمن حدده في نفس الوقت).
// - الأدمن يقدر يعمل كل حاجة، وهو بس اللي يغير المناطق والنسب.
// - الأدمن بس اللي يعمل كوبونات الخصم، والعميل بيستخدمها في حدود شروطها.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // حساب شغال: مش محظور ومش محذوف
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().get('banned', false) == false
        && me().get('deleted', false) == false;
    }

    // موظف خدمة العملاء: الشكاوي وطلبات الانضمام بس
    function isStaff() {
      return isActive() && me().role == 'staff';
    }

    function isTeam() {
      return isAdmin() || isStaff();
    }

    function application(uid) {
      return get(/databases/$(database)/documents/applications/$(uid)).data;
    }

    function isDriver() {
      return isActive() && me().role == 'driver';
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // اسم المستخدم ورقم الموبايل لازم يكونوا محجوزين باسم الحساب ده في نفس العملية
    function ownsUsername(uid, name) {
      return existsAfter(/databases/$(database)/documents/usernames/$(name))
        && getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid;
    }

    function ownsPhone(uid, phone) {
      return existsAfter(/databases/$(database)/documents/phones/$(phone))
        && getAfter(/databases/$(database)/documents/phones/$(phone)).data.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());
      // أي حساب جديد بيبدأ عميل؛ الأدمن بس اللي يغير الدور
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.get('restaurantId', null) == null
        && request.resource.data.email == request.auth.token.email.lower()
        // لازم يكون وافق على الشروط وسياسة الخصوصية
        && request.resource.data.terms.version is string
        && request.resource.data.terms.version.size() > 0
        // وموافقة صريحة ومنفصلة على تخزين البيانات خارج مصر
        && request.resource.data.terms.transfer == true
        && (!('username' in request.resource.data) || ownsUsername(uid, request.resource.data.username))
        && (request.resource.data.get('phone', '') == '' || ownsPhone(uid, request.resource.data.phone));
      allow update: if isAdmin()
        // الموظف: يحوّل عميل لمندوب أو صاحب مطعم بس لو عنده طلب انضمام مستني من نفس النوع
        || (isStaff()
            && changedOnly(['role', 'restaurantId'])
            && resource.data.role == 'customer'
            && application(uid).status == 'pending'
            && request.resource.data.role == application(uid).type
            && request.resource.data.role in ['driver', 'restaurant'])
        || (signedIn() && request.auth.uid == uid
            && resource.data.get('deleted', false) == false
            && changedOnly(['name', 'phone', 'address', 'location', 'username', 'terms'])
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['terms'])
                || (request.resource.data.terms.version is string && request.resource.data.terms.transfer == true))
            // اسم المستخدم بيتحدد مرة واحدة بس
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
                || (!('username' in resource.data) && ownsUsername(uid, request.resource.data.username)))
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone'])
                || ownsPhone(uid, request.resource.data.phone)));
      allow delete: if isAdmin();
    }

    // usernames/{اسم} و phones/{رقم} = { uid }. مينفعش يتعدلوا، فأول واحد يحجز بياخد
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_.]{3,20}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow delete: if isAdmin();
    }

    match /phones/{phone} {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && phone.matches('^01[0-9]{9}$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == phone;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // إعدادات المنصة: المناطق وأسعار التوصيل والنسب
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // طلبات الانضمام: كل واحد يقدّم طلبه بنفسه (قيد المراجعة بس)، والأدمن بس اللي يوافق أو يرفض
    match /applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());
      allow create, update: if isAdmin()
        || (isStaff() && resource != null
            && resource.data.status == 'pending'
            && request.resource.data.status in ['approved', 'rejected']
            && changedOnly(['status', 'reviewedAt', 'reviewedBy']))
        || (isActive() && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.resource.data.status == 'pending'
            && request.resource.data.type in ['driver', 'restaurant']);
      allow delete: if isAdmin();
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if isAdmin()
        // الموظف: يعمل مطعم جديد (مقفول) لصاحب طلب انضمام مطعم مستني، ويربطه بيه في نفس العملية
        || (isStaff()
            && request.resource.data.isOpen == false
            && request.resource.data.get('blocked', false) == false
            && application(request.resource.data.ownerUid).status == 'pending'
            && application(request.resource.data.ownerUid).type == 'restaurant'
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.ownerUid)).data.restaurantId == restaurantId);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isActive()
            && resource.data.get('ownerUid', null) == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['ownerUid', 'ownerEmail', 'ownerUsername', 'rating', 'reviews', 'blocked']));
    }

    // خدمة العملاء: كل واحد يشوف شكاويه بس ويضيف رسايل جديدة (ميعدلش القديمة)، والأدمن يرد ويقفل
    match /tickets/{ticketId} {
      // رسالة من المستخدم: نص لحد 2000 حرف، وصورة اختيارية من حساب Cloudinary بتاع أريفو (qrp8inik) بس
      // (لو غيّرت حساب Cloudinary في cloudinary-config.js غيّر الاسم هنا كمان)
      function userMessageOk(m) {
        return m.by == request.auth.uid
          && m.name is string && m.name.size() <= 60
          && m.at is int
          && m.text is string && m.text.size() <= 2000
          && m.keys().hasOnly(['by', 'name', 'text', 'at', 'image'])
          && (!('image' in m) || (m.image is string && m.image.size() <= 500
              && m.image.matches('^https://res[.]cloudinary[.]com/qrp8inik/[A-Za-z0-9_./,:-]+$')));
      }
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isTeam());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && me().get('deleted', false) == false
        && request.resource.data.status == 'open'
        && request.resource.data.lastBy == 'user'
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 100
        && request.resource.data.messages.size() == 1
        && userMessageOk(request.resource.data.messages[0]);
      allow update: if isAdmin()
        // الموظف: يرد ويقفل ويفتح، بس ميعدلش أو يمسح رسايل قديمة
        || (isStaff()
            && changedOnly(['messages', 'updatedAt', 'lastBy', 'status'])
            && request.resource.data.messages.size() >= resource.data.messages.size()
            && request.resource.data.messages.hasAll(resource.data.messages))
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && changedOnly(['messages', 'updatedAt', 'lastBy', 'status'])
            && request.resource.data.lastBy == 'user'
            && request.resource.data.status == 'open'
            && request.resource.data.messages.size() == resource.data.messages.size() + 1
            && request.resource.data.messages.hasAll(resource.data.messages)
            && userMessageOk(request.resource.data.messages[resource.data.messages.size()]));
      allow delete: if isAdmin();
    }

    // كوبونات الخصم: اسم المستند هو الكود. أي حد يقدر يتأكد من كود يعرفه (get)،
    // بس محدش يقدر يجيب لستة الأكواد غير الأدمن.
    match /coupons/{code} {
      function newOrder() {
        return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrder)).data;
      }
      allow get: if true;
      allow list, create, delete: if isAdmin();
      // العميل: بيزوّد عداد الاستخدام 1 مع طلب جديد بيعمله دلوقتي وفيه الكود ده
      allow update: if isAdmin()
        || (isActive()
            && changedOnly(['used', 'lastOrder'])
            && request.resource.data.used == resource.data.get('used', 0) + 1
            && newOrder().customerUid == request.auth.uid
            && newOrder().createdAt == request.time
            && code in newOrder().get('promos', []));
    }

    // العميل استخدم كوبون "مرة واحدة لكل عميل" (بيتعمل مع الطلب، ومبيتعدلش)
    match /couponUses/{uid}/codes/{code} {
      function newOrder() {
        return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data;
      }
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isActive()
        && request.auth.uid == uid
        && newOrder().customerUid == uid
        && newOrder().createdAt == request.time
        && code in newOrder().get('promos', []);
      allow delete: if isAdmin();
    }

    // الأوردرات اللي مع المندوب دلوقتي. كل عملية بتضيف أوردر واحد أخده (في حدود العدد اللي الأدمن حدده)
    // أو بتشيل أوردر واحد خلص أو اتلغى أو مبقاش معاه.
    match /driverLoads/{uid} {
      function before() {
        return resource == null ? [] : resource.data.get('orders', []);
      }
      function added() {
        return request.resource.data.orders.removeAll(before());
      }
      function removed() {
        return before().removeAll(request.resource.data.orders);
      }
      function orderAfter(id) {
        return getAfter(/databases/$(database)/documents/orders/$(id)).data;
      }
      function maxOrders() {
        return get(/databases/$(database)/documents/settings/app).data.get('maxDriverOrders', 3);
      }
      allow read: if signedIn() && (request.auth.uid == uid || isTeam());
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        || (isDriver()
            && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['orders'])
            && request.resource.data.orders is list
            && added().size() + removed().size() == 1
            && (added().size() == 0
                || ((maxOrders() == 0 || request.resource.data.orders.size() <= maxOrders())
                    && orderAfter(added()[0]).driverUid == uid))
            && (removed().size() == 0
                || orderAfter(removed()[0]).driverUid != uid
                || orderAfter(removed()[0]).status in ['delivered', 'cancelled', 'rejected']));
    }

    match /orders/{orderId} {
      function restaurant() {
        return get(/databases/$(database)/documents/restaurants/$(request.resource.data.restaurantId)).data;
      }

      function settings() {
        return get(/databases/$(database)/documents/settings/app).data;
      }

      // كوبون واحد: شغال ومخلصش وشروطه متحققة، وعداده زاد 1 في نفس العملية (وسجل الاستخدام لو مرة لكل عميل)
      function couponOk(code) {
        let path = /databases/$(database)/documents/coupons/$(code);
        let c = get(path).data;
        let after = getAfter(path).data;
        return c.get('active', false) == true
          && (c.get('expiresAt', null) == null || request.time.toMillis() <= c.expiresAt)
          && request.resource.data.totals.subtotal >= c.get('minOrder', 0)
          && after.get('used', 0) == c.get('used', 0) + 1
          && (c.get('limit', 0) == 0 || after.get('used', 0) <= c.limit)
          && (c.get('onePerCustomer', false) != true
              || existsAfter(/databases/$(database)/documents/couponUses/$(request.auth.uid)/codes/$(code)));
      }

      // في حدود العدد اللي الأدمن سامح بيه (وأقصى حاجة 2)، ومن غير تكرار نفس الكود
      function couponsOk(codes) {
        return codes is list
          && codes.size() <= settings().get('couponsPerOrder', 1)
          && codes.size() <= 2
          && codes.toSet().size() == codes.size()
          && (codes.size() < 1 || couponOk(codes[0]))
          && (codes.size() < 2 || couponOk(codes[1]));
      }

      function driverFields() {
        return ['driverUid', 'driverName', 'driverPhone', 'driverUsername', 'claimedAt'];
      }

      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid
        || resource.data.ownerUid == request.auth.uid
        || isTeam()
        || (isDriver() && (
              resource.data.driverUid == request.auth.uid
              || (resource.data.driverUid == null && resource.data.status in ['preparing', 'ready']))));

      allow create: if isActive()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.createdAt == request.time
        && request.resource.data.lines is list
        && request.resource.data.lines.size() > 0
        && request.resource.data.lines.size() <= 50
        && restaurant().get('isOpen', true) == true
        && restaurant().get('blocked', false) == false
        && request.resource.data.ownerUid == restaurant().get('ownerUid', null)
        && request.resource.data.driverUid == null
        // رسوم التوصيل لازم تكون سعر المنطقة، والنسب هي نسب المنصة الحالية
        && request.resource.data.rates == settings().rates
        && request.resource.data.zoneId in settings().zones
        && settings().zones[request.resource.data.zoneId].get('active', true) == true
        && request.resource.data.totals.delivery == settings().zones[request.resource.data.zoneId].fee
        && couponsOk(request.resource.data.get('promos', []));

      allow update: if isAdmin()
        // صاحب المطعم: يقبل أو يرفض، وبعدين "جاهز للتسليم"
        || (isActive()
            && resource.data.ownerUid == request.auth.uid
            && changedOnly(['status', 'statusHistory', 'updatedAt'])
            && ((resource.data.status == 'placed' && request.resource.data.status in ['preparing', 'rejected'])
                || (resource.data.status == 'preparing' && request.resource.data.status == 'ready')))
        // المندوب: ياخد أوردر محدش أخده (ولازم يتسجل في لستة أوردراته اللي ليها حد أقصى)
        || (isDriver()
            && resource.data.driverUid == null
            && resource.data.status in ['preparing', 'ready']
            && request.resource.data.driverUid == request.auth.uid
            && changedOnly(driverFields())
            && orderId in getAfter(/databases/$(database)/documents/driverLoads/$(request.auth.uid)).data.get('orders', []))
        // المندوب: يسيب الأوردر قبل ما يستلمه
        || (isDriver()
            && resource.data.driverUid == request.auth.uid
            && resource.data.status in ['preparing', 'ready']
            && request.resource.data.driverUid == null
            && changedOnly(driverFields()))
        // المندوب: استلم من المطعم، وبعدين وصّل
        || (isDriver()
            && resource.data.driverUid == request.auth.uid
            && changedOnly(['status', 'statusHistory', 'updatedAt'])
            && ((resource.data.status == 'ready' && request.resource.data.status == 'on_way')
                || (resource.data.status == 'on_way' && request.resource.data.status == 'delivered')))
        // العميل: يلغي قبل ما المطعم يقبل
        || (signedIn()
            && resource.data.customerUid == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled'
            && changedOnly(['status', 'statusHistory', 'updatedAt']));
    }
  }
}
